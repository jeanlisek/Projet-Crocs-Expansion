	partition fact_parts_de_marche = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DossierExports & "fact_parts_de_marche.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Types = Table.TransformColumnTypes(Entetes, {{"code_pays", type text}, {"annee", Int64.Type}, {"id_concurrent", type text}, {"part_marche_valeur_pct", type number}, {"ca_estime_meur", type number}, {"source", type text}, {"est_simule", type logical}}, "en-US")
				in
					Types

