table sensibilite_payback
	lineageTag: b4f8f0fe-bb00-4ed9-88ca-e8188791f0ed

	measure 'Payback sensi' = VAR p = SELECTEDVALUE ( sensibilite_payback[payback_mois] ) RETURN IF ( COUNTROWS ( sensibilite_payback ) <> 1, BLANK (), IF ( ISBLANK ( p ), "> 120", SUBSTITUTE ( FORMAT ( p, "0.0" ), ".", "," ) ) )
		lineageTag: f2b3ce4a-d2d7-45c2-955d-c04b14c8c587

	measure 'Couleur sensi' = VAR p = SELECTEDVALUE ( sensibilite_payback[payback_mois] ) RETURN IF ( COUNTROWS ( sensibilite_payback ) <> 1, BLANK (), SWITCH ( TRUE (), ISBLANK ( p ), "#E3A857", p <= 30, "#6FA800", p <= 36, "#A6D45A", p <= 48, "#F3EBC8", p <= 72, "#F2D29B", "#EBB872" ) )
		lineageTag: 167acb7a-8b5a-4e1e-a5d7-b5718e53f854

	column etp_libelle = SUBSTITUTE ( FORMAT ( sensibilite_payback[nb_etp], "0.0#" ), ".", "," ) & " ETP" & IF ( sensibilite_payback[nb_etp] > 5.35, " (actuel)", "" )
		dataType: string
		lineageTag: c6144c3f-fc51-4b4c-b265-aed7603c6f64
		summarizeBy: none
		sortByColumn: nb_etp

	column ratio_libelle = FORMAT ( sensibilite_payback[ratio_ca_m2_vs_france] * 100, "0" ) & " %"
		dataType: string
		lineageTag: f7f60572-f397-46ab-a813-9d66d110e531
		summarizeBy: none
		sortByColumn: ratio_ca_m2_vs_france

