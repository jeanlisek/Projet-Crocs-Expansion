	partition sensibilite_payback = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DossierExports & "sensibilite_payback.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Types = Table.TransformColumnTypes(Entetes, {{"code_pays", type text}, {"scenario", type text}, {"format", type text}, {"nb_etp", type number}, {"ratio_ca_m2_vs_france", type number}, {"ca_m2_eur", type number}, {"payback_mois", type number}, {"seuil", type text}, {"statut_go", type text}, {"ca_m2_ratio_min_go", type number}, {"etp_max_go", type number}, {"est_cas_business_case", type logical}, {"origine_donnees", type text}}, "en-US")
