					Types = Table.TransformColumnTypes(Entetes, {{"id_zone", type text}, {"ville", type text}, {"population_millions", type number}, {"origine_population", type text}, {"potentiel_millions_ponderes", type number}, {"cout_m2_an_eur", type number}, {"densite_pour_100k_hab", type number}, {"distance_hub_km", type number}, {"note_potentiel", type number}, {"note_loyer", type number}, {"note_densite", type number}, {"note_distance", type number}, {"score", type number}, {"rang", Int64.Type}, {"est_prioritaire", type logical}, {"origine_donnees", type text}}, "en-US")
