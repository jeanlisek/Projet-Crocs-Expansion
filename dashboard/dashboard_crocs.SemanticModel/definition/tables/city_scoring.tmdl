	measure 'Txt score' = /* #v8 */ IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( SUM ( city_scoring[score] ), "0.0" ), ",", " " ), ".", "," ) )
		lineageTag: ddca9139-a9b2-4b21-b548-6e9dea765a84

	measure 'Txt potentiel' = /* #v8 */ IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( SUM ( city_scoring[note_potentiel] ), "0" ), ",", " " ), ".", "," ) )
		lineageTag: fbdd8b4d-389c-412c-aa37-852a2c5ddefb

	measure 'Txt loyer' = /* #v8 */ IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( SUM ( city_scoring[note_loyer] ), "0" ), ",", " " ), ".", "," ) )
		lineageTag: 19e29e32-3f6a-470e-96d3-75c6d3beea7d

	measure 'Txt densité' = /* #v8 */ IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( SUM ( city_scoring[note_densite] ), "0" ), ",", " " ), ".", "," ) )
		lineageTag: de67f91c-d95a-45f4-85e4-59b5ff57e061

	measure 'Txt distance' = /* #v8 */ IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( SUM ( city_scoring[note_distance] ), "0" ), ",", " " ), ".", "," ) )
		lineageTag: 764e47cd-a194-4b82-938e-111e710ac612

	measure 'Txt loyer €' = /* #v8 */ IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( SUM ( city_scoring[cout_m2_an_eur] ), "#,0" ), ",", " " ), ".", "," ) )
		lineageTag: 2dfaff80-6d1a-4454-9a85-c2634636c516

	measure 'Txt densité réelle' = /* #v8 */ IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( SUM ( city_scoring[densite_pour_100k_hab] ), "0.00" ), ",", " " ), ".", "," ) )
		lineageTag: 217a9dc6-8681-41e8-9b63-b73ed1dafd8b

	measure 'Txt km' = /* #v8 */ IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( SUM ( city_scoring[distance_hub_km] ), "#,0" ), ",", " " ), ".", "," ) )
		lineageTag: 1eb01386-38f5-483e-af31-f568276dd018

	measure 'Fond ville' = /* #v8 */ IF ( SELECTEDVALUE ( city_scoring[est_prioritaire] ) = TRUE (), "#E6F2CC", "#FFFFFF" )
		lineageTag: c8b1ffbc-e63f-4fe0-9ca0-a3c0b87e3866

	measure 'Couleur densité' = /* #v8 */ VAR d = SELECTEDVALUE ( city_scoring[densite_pour_100k_hab] ) VAR r = RANKX ( FILTER ( ALL ( city_scoring ), city_scoring[est_prioritaire] = TRUE () ), city_scoring[densite_pour_100k_hab], d, ASC ) RETURN SWITCH ( TRUE (), r <= 2, "#2F6B00", r <= 4, "#6FA800", "#B5DB7A" )
		lineageTag: 8141dac3-e782-4b4e-b9d2-771f00df958d

	measure 'Txt revenu' = /* #v8 */ VAR z = SELECTEDVALUE ( city_scoring[id_zone] ) VAR x = LOOKUPVALUE ( dim_zone_chalandise[indice_revenu_ue100], dim_zone_chalandise[id_zone], z ) RETURN IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( x, "0" ), ",", " " ), ".", "," ) & "" )
		lineageTag: b89715d8-c794-49ed-b7a5-67e43e86cf78

	measure 'Txt centres' = /* #v8 */ VAR z = SELECTEDVALUE ( city_scoring[id_zone] ) VAR x = LOOKUPVALUE ( dim_zone_chalandise[nb_centres_commerciaux], dim_zone_chalandise[id_zone], z ) RETURN IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( x, "0" ), ",", " " ), ".", "," ) & "" )
		lineageTag: f0f1ccb4-8fc7-4cb1-b122-d5aa6ffdc182

	measure 'Txt magasins' = /* #v8 */ VAR z = SELECTEDVALUE ( city_scoring[id_zone] ) VAR x = LOOKUPVALUE ( densite_concurrentielle[nb_magasins_chaussures], densite_concurrentielle[id_zone], z ) RETURN IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( x, "0" ), ",", " " ), ".", "," ) & "" )
		lineageTag: 0a017b49-bd19-477e-bc00-75c793b0a6d5

	measure 'Txt population' = /* #v8 */ VAR z = SELECTEDVALUE ( city_scoring[id_zone] ) VAR x = LOOKUPVALUE ( city_scoring[population_millions], city_scoring[id_zone], z ) RETURN IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( x, "0.00" ), ",", " " ), ".", "," ) & " M" )
		lineageTag: 90aab05d-7613-4cd6-bca0-d96b126c9571

	measure 'Txt trajet' = /* #v8 */ VAR z = SELECTEDVALUE ( city_scoring[id_zone] ) VAR x = LOOKUPVALUE ( distance_hub[duree_conduite_h], distance_hub[id_zone], z ) VAR k = SELECTEDVALUE ( city_scoring[distance_hub_km] ) RETURN IF ( HASONEVALUE ( city_scoring[ville] ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( k, "#,0" ), ",", " " ), ".", "," ) & " km · " & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( x, "0.0" ), ",", " " ), ".", "," ) & " h" )
		lineageTag: abb79505-025e-4b2c-ab24-2a8b652ccfc8

	measure 'Rang ville' = /* #v8 */ IF ( HASONEVALUE ( city_scoring[ville] ), SUM ( city_scoring[rang] ) )
		formatString: 0
		lineageTag: 1ec2368f-b4dd-484d-b426-712f06254909

