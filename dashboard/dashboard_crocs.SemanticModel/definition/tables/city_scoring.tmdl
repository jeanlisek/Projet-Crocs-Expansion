	measure 'Ville Distance hub vs moy' = /* #v8 */ VAR v = AVERAGE ( city_scoring[distance_hub_km] ) VAR m = CALCULATE ( AVERAGE ( city_scoring[distance_hub_km] ), REMOVEFILTERS ( dim_zone_chalandise ), REMOVEFILTERS ( city_scoring ), city_scoring[est_prioritaire] = TRUE () ) VAR one = HASONEVALUE ( city_scoring[ville] ) VAR d = v - m RETURN IF ( NOT one, "= moyenne des 6 villes prioritaires", IF ( d > 0, "▲ +", IF ( d < 0, "▼ −", "= " ) ) & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ABS ( d ), "#,0" ), ",", " " ), ".", "," ) & " vs moyenne des 6 villes" )
