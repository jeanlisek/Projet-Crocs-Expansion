table city_scoring
	lineageTag: 3558fe83-9480-4a49-a702-ff9f21fc15ae

	measure 'Nb villes prioritaires' = CALCULATE ( COUNTROWS ( city_scoring ), city_scoring[est_prioritaire] = TRUE () )
		formatString: 0
		lineageTag: 190e9244-d0fb-4e11-94e9-13ed73e52129

	measure 'Couleur ville' = IF ( SELECTEDVALUE ( city_scoring[est_prioritaire] ) = TRUE (), "#84BD00", "#C9CFC0" )
		lineageTag: e72cd941-2c27-4b88-98c8-518ed3f86c26

	measure 'Ville Score' = /* #v8 */ VAR v = AVERAGE ( city_scoring[score] ) VAR m = CALCULATE ( AVERAGE ( city_scoring[score] ), REMOVEFILTERS ( dim_zone_chalandise ), REMOVEFILTERS ( city_scoring ), city_scoring[est_prioritaire] = TRUE () ) VAR one = HASONEVALUE ( city_scoring[ville] ) VAR d = v - m RETURN SUBSTITUTE ( SUBSTITUTE ( FORMAT ( v, "0.0" ), ",", " " ), ".", "," ) & " /100"
		lineageTag: 9a6fe2be-8ff9-4d3e-8a56-d1cfa6a19266

	measure 'Ville Score vs moy' = /* #v8 */ VAR v = AVERAGE ( city_scoring[score] ) VAR m = CALCULATE ( AVERAGE ( city_scoring[score] ), REMOVEFILTERS ( dim_zone_chalandise ), REMOVEFILTERS ( city_scoring ), city_scoring[est_prioritaire] = TRUE () ) VAR one = HASONEVALUE ( city_scoring[ville] ) VAR d = v - m RETURN IF ( NOT one, "= moyenne des 6 villes prioritaires", IF ( d > 0, "▲ +", IF ( d < 0, "▼ −", "= " ) ) & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ABS ( d ), "0.0" ), ",", " " ), ".", "," ) & " vs moyenne des 6 villes" )
		lineageTag: cb16125f-9038-4b7c-80c0-11076d4fc5c0

