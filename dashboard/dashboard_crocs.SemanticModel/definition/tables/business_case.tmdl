	partition business_case = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DossierExports & "business_case.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Types = Table.TransformColumnTypes(Entetes, {{"code_pays", type text}, {"scenario", type text}, {"format", type text}, {"surface_m2", type number}, {"ca_m2_croisiere_eur", type number}, {"ca_ht_croisiere_eur", type number}, {"taux_marge_brute_pct", type number}, {"loyer_charges_eur", type number}, {"personnel_eur", type number}, {"energie_eur", type number}, {"couts_variables_eur", type number}, {"ebitda_croisiere_eur", type number}, {"resultat_croisiere_eur", type number}, {"investissement_eur", type number}, {"cout_occupation_pct", type number}, {"point_mort_ca_ht_eur", type number}, {"payback_mois", type number}, {"horizon_annees", Int64.Type}, {"origine_donnees", type text}}, "en-US")
				in
					Types

