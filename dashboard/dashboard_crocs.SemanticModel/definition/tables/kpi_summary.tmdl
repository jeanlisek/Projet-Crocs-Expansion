	measure 'Taille marché 2025 vs pays' = /* #v8 */ VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR v = CALCULATE ( SUM ( fact_marche[taille_marche_meur] ), REMOVEFILTERS ( dim_pays ), fact_marche[code_pays] = p, fact_marche[annee] = 2025, fact_marche[segment] = "Casual moulé & sandales" ) VAR w = CALCULATE ( SUM ( fact_marche[taille_marche_meur] ), REMOVEFILTERS ( dim_pays ), fact_marche[code_pays] = r, fact_marche[annee] = 2025, fact_marche[segment] = "Casual moulé & sandales" ) VAR a = CALCULATE ( SUM ( fact_marche[taille_marche_meur] ), REMOVEFILTERS ( dim_pays ), fact_marche[code_pays] = p, fact_marche[annee] = 2024, fact_marche[segment] = "Casual moulé & sandales" ) VAR d = DIVIDE ( v - w, w ) * 100 RETURN IF ( ISBLANK ( v ) || ISBLANK ( w ), "–", IF ( d > 0, "▲ +", IF ( d < 0, "▼ −", "= " ) ) & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ABS ( d ), "0.00" ), ",", " " ), ".", "," ) & " %" & " vs " & nr )
