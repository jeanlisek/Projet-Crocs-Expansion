	column valeur_affichee = IF ( ISBLANK ( kpi_summary[valeur] ), IF ( CONTAINSSTRING ( kpi_summary[kpi], "Payback" ), "Non remboursé en 10 ans", "n.d." ), SUBSTITUTE ( IF ( kpi_summary[valeur] = INT ( kpi_summary[valeur] ), FORMAT ( kpi_summary[valeur], "0" ), FORMAT ( kpi_summary[valeur], "0.0#" ) ), ".", "," ) & " " & kpi_summary[unite] )
		dataType: string
		lineageTag: 8253af9f-c623-4566-b785-b93e8dbd1f29
		summarizeBy: none

	column axe_ordre = SWITCH ( kpi_summary[axe], "Marché", 1, "Prix", 2, "Assortiment", 3, "Rentabilité", 4, "Logistique", 5, "Réseau", 6, 9 )
		dataType: int64
		lineageTag: 98f67b4c-1caf-4d21-a583-5265f78b6e8a
		summarizeBy: none

	column seuil_num = VAR s = kpi_summary[seuil] VAR t = TRIM ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( s, "≥", "" ), "≤", "" ), "%", "" ), "mois", "" ) ) RETURN IF ( ISBLANK ( s ) || s = "" || CONTAINSSTRING ( s, " à " ), BLANK (), IFERROR ( VALUE ( t ), BLANK () ) )
		dataType: double
		lineageTag: 0f2952da-cd37-4808-9816-4b8eedbf882e
		summarizeBy: none

	column origine_libelle = SWITCH ( kpi_summary[origine_donnees], "REEL", "Réel", "SIMULE", "Simulé", "MIXTE", "Mixte", kpi_summary[origine_donnees] )
		dataType: string
		lineageTag: 53acb5d5-29c5-450e-90ec-0af82c142f51
		summarizeBy: none

	column axe_libelle = kpi_summary[axe]
		dataType: string
		lineageTag: 903a40e3-7e5f-4fe1-9f53-0661ec8bdbf0
		summarizeBy: none
		sortByColumn: axe_ordre

	partition kpi_summary = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DossierExports & "kpi_summary.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Types = Table.TransformColumnTypes(Entetes, {{"kpi", type text}, {"axe", type text}, {"pays", type text}, {"valeur", type number}, {"unite", type text}, {"seuil", type text}, {"statut_go", type text}, {"statut_epistemique", type text}, {"origine_donnees", type text}}, "en-US")
				in
					Types

