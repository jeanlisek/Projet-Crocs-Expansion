	measure 'Écart au seuil' = /* #v8 */ VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR k = SELECTEDVALUE ( kpi_summary[kpi] ) VAR suf = MID ( k, SEARCH ( " : ", k, 1, LEN ( k ) ) + 3, 200 ) VAR kr = SWITCH ( TRUE (), CONTAINSSTRING ( k, "Coût d'occupation (loyer + charges ÷ CA, scénario" ), "Coût d'occupation (loyer + charges ÷ CA, même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Payback (scénario" ), "Payback (même périmètre de coûts que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Point mort par magasin : " ), "Point mort par magasin (même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Impôt sur les sociétés (taux combiné" ), "Impôt sur les sociétés (taux normal, hors surtaxes)", CONTAINSSTRING ( k, "Impôt sur les sociétés (taux normal" ), "Impôt sur les sociétés (taux combiné : IS, solidarité et taxe professionnelle moyenne incluses)", k ) VAR v = CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR nv = CALCULATE ( COUNTROWS ( kpi_summary ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR w = IF ( r = "FR" && CONTAINSSTRING ( k, "Indice prix relatif (HT" ), 100, CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = r, kpi_summary[kpi] = kr ) ) VAR u = CALCULATE ( MAX ( kpi_summary[unite] ), REMOVEFILTERS ( dim_pays ) ) VAR fm = SWITCH ( TRUE (), u = "mois", "0.0", u = "km" || CONTAINSSTRING ( u, "€" ), "#,0", "0.00" ) VAR us = SWITCH ( u, "%", " %", "indice", "", " " & u ) VAR ug = SWITCH ( u, "%", " pt", "indice", " pt", " " & u ) VAR inv = CONTAINSSTRING ( k, "Coût" ) || CONTAINSSTRING ( k, "Payback" ) || CONTAINSSTRING ( k, "Point mort" ) || CONTAINSSTRING ( k, "Impôt" ) || CONTAINSSTRING ( k, "TVA" ) || CONTAINSSTRING ( k, "Droit" ) || CONTAINSSTRING ( k, "Densité" ) || CONTAINSSTRING ( k, "Distance" ) || CONTAINSSTRING ( k, "Éco-contribution" ) VAR pb = CONTAINSSTRING ( k, "Payback" ) VAR s = CALCULATE ( MAX ( kpi_summary[seuil] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = "DE" ) VAR n = CALCULATE ( MAX ( kpi_summary[seuil_num] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = "DE" ) VAR nf = IF ( n = INT ( n ), FORMAT ( n, "0" ), SUBSTITUTE ( FORMAT ( n, "0.00" ), ".", "," ) ) RETURN SWITCH ( TRUE (), nv = 0 || ISBLANK ( s ) || s = "", BLANK (), CONTAINSSTRING ( s, " à " ), IF ( v < 95, "−" & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( 95 - v, "0.00" ), ",", " " ), ".", "," ) & " pt sous le seuil 95-110", IF ( v > 110, "+" & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( v - 110, "0.00" ), ",", " " ), ".", "," ) & " pt au-dessus du seuil 95-110", "+" & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( v - 95, "0.00" ), ",", " " ), ".", "," ) & " pt vs borne 95 (seuil 95-110)" ) ), ISBLANK ( v ), "> 120 mois (seuil " & nf & ")", IF ( v - n >= 0, "+", "−" ) & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ABS ( v - n ), fm ), ",", " " ), ".", "," ) & ug & " vs seuil " & nf & us )
		lineageTag: 9f8669c1-b3e5-4b12-a336-78c2007fb2aa

	measure 'Couleur écart au seuil' = /* #v8 */ VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR k = SELECTEDVALUE ( kpi_summary[kpi] ) VAR suf = MID ( k, SEARCH ( " : ", k, 1, LEN ( k ) ) + 3, 200 ) VAR kr = SWITCH ( TRUE (), CONTAINSSTRING ( k, "Coût d'occupation (loyer + charges ÷ CA, scénario" ), "Coût d'occupation (loyer + charges ÷ CA, même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Payback (scénario" ), "Payback (même périmètre de coûts que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Point mort par magasin : " ), "Point mort par magasin (même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Impôt sur les sociétés (taux combiné" ), "Impôt sur les sociétés (taux normal, hors surtaxes)", CONTAINSSTRING ( k, "Impôt sur les sociétés (taux normal" ), "Impôt sur les sociétés (taux combiné : IS, solidarité et taxe professionnelle moyenne incluses)", k ) VAR v = CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR nv = CALCULATE ( COUNTROWS ( kpi_summary ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR w = IF ( r = "FR" && CONTAINSSTRING ( k, "Indice prix relatif (HT" ), 100, CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = r, kpi_summary[kpi] = kr ) ) VAR u = CALCULATE ( MAX ( kpi_summary[unite] ), REMOVEFILTERS ( dim_pays ) ) VAR fm = SWITCH ( TRUE (), u = "mois", "0.0", u = "km" || CONTAINSSTRING ( u, "€" ), "#,0", "0.00" ) VAR us = SWITCH ( u, "%", " %", "indice", "", " " & u ) VAR ug = SWITCH ( u, "%", " pt", "indice", " pt", " " & u ) VAR inv = CONTAINSSTRING ( k, "Coût" ) || CONTAINSSTRING ( k, "Payback" ) || CONTAINSSTRING ( k, "Point mort" ) || CONTAINSSTRING ( k, "Impôt" ) || CONTAINSSTRING ( k, "TVA" ) || CONTAINSSTRING ( k, "Droit" ) || CONTAINSSTRING ( k, "Densité" ) || CONTAINSSTRING ( k, "Distance" ) || CONTAINSSTRING ( k, "Éco-contribution" ) VAR pb = CONTAINSSTRING ( k, "Payback" ) VAR s = CALCULATE ( MAX ( kpi_summary[seuil] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = "DE" ) VAR n = CALCULATE ( MAX ( kpi_summary[seuil_num] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = "DE" ) VAR nf = IF ( n = INT ( n ), FORMAT ( n, "0" ), SUBSTITUTE ( FORMAT ( n, "0.00" ), ".", "," ) ) VAR ok = SWITCH ( TRUE (), CONTAINSSTRING ( s, " à " ), v >= 95 && v <= 110, ISBLANK ( v ), FALSE (), CONTAINSSTRING ( s, "≤" ), v <= n, v >= n ) RETURN IF ( nv = 0 || ISBLANK ( s ) || s = "", "#80868B", IF ( ok, "#2E7D32", "#C62828" ) )
		lineageTag: 2afb6056-0607-4c52-84aa-d5d9372b432e

	measure 'Tab Allemagne' = /* #v8 */ VAR p = "DE" VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR k = SELECTEDVALUE ( kpi_summary[kpi] ) VAR suf = MID ( k, SEARCH ( " : ", k, 1, LEN ( k ) ) + 3, 200 ) VAR kr = SWITCH ( TRUE (), CONTAINSSTRING ( k, "Coût d'occupation (loyer + charges ÷ CA, scénario" ), "Coût d'occupation (loyer + charges ÷ CA, même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Payback (scénario" ), "Payback (même périmètre de coûts que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Point mort par magasin : " ), "Point mort par magasin (même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Impôt sur les sociétés (taux combiné" ), "Impôt sur les sociétés (taux normal, hors surtaxes)", CONTAINSSTRING ( k, "Impôt sur les sociétés (taux normal" ), "Impôt sur les sociétés (taux combiné : IS, solidarité et taxe professionnelle moyenne incluses)", k ) VAR v = CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR nv = CALCULATE ( COUNTROWS ( kpi_summary ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR w = IF ( r = "FR" && CONTAINSSTRING ( k, "Indice prix relatif (HT" ), 100, CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = r, kpi_summary[kpi] = kr ) ) VAR u = CALCULATE ( MAX ( kpi_summary[unite] ), REMOVEFILTERS ( dim_pays ) ) VAR fm = SWITCH ( TRUE (), u = "mois", "0.0", u = "km" || CONTAINSSTRING ( u, "€" ), "#,0", "0.00" ) VAR us = SWITCH ( u, "%", " %", "indice", "", " " & u ) VAR ug = SWITCH ( u, "%", " pt", "indice", " pt", " " & u ) VAR inv = CONTAINSSTRING ( k, "Coût" ) || CONTAINSSTRING ( k, "Payback" ) || CONTAINSSTRING ( k, "Point mort" ) || CONTAINSSTRING ( k, "Impôt" ) || CONTAINSSTRING ( k, "TVA" ) || CONTAINSSTRING ( k, "Droit" ) || CONTAINSSTRING ( k, "Densité" ) || CONTAINSSTRING ( k, "Distance" ) || CONTAINSSTRING ( k, "Éco-contribution" ) VAR pb = CONTAINSSTRING ( k, "Payback" ) VA