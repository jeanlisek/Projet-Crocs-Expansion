	measure 'Taille marché 2025 vs 2024' = /* #v8 */ VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR v = CALCULATE ( SUM ( fact_marche[taille_marche_meur] ), REMOVEFILTERS ( dim_pays ), fact_marche[code_pays] = p, fact_marche[annee] = 2025, fact_marche[segment] = "Casual moulé & sandales" ) VAR w = CALCULATE ( SUM ( fact_marche[taille_marche_meur] ), REMOVEFILTERS ( dim_pays ), fact_marche[code_pays] = r, fact_marche[annee] = 2025, fact_marche[segment] = "Casual moulé & sandales" ) VAR a = CALCULATE ( SUM ( fact_marche[taille_marche_meur] ), REMOVEFILTERS ( dim_pays ), fact_marche[code_pays] = p, fact_marche[annee] = 2024, fact_marche[segment] = "Casual moulé & sandales" ) VAR d = DIVIDE ( v - a, a ) * 100 RETURN IF ( ISBLANK ( v ) || ISBLANK ( a ), "–", IF ( d > 0, "▲ +", IF ( d < 0, "▼ −", "= " ) ) & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ABS ( d ), "0.00" ), ",", " " ), ".", "," ) & " %" & " vs " & "2024" )
		lineageTag: 30de7a3c-b3f9-4b4e-99fe-1b5f522fa659

	measure 'Taille marché 2025 vs 2024 couleur' = /* #v8 */ VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR v = CALCULATE ( SUM ( fact_marche[taille_marche_meur] ), REMOVEFILTERS ( dim_pays ), fact_marche[code_pays] = p, fact_marche[annee] = 2025, fact_marche[segment] = "Casual moulé & sandales" ) VAR w = CALCULATE ( SUM ( fact_marche[taille_marche_meur] ), REMOVEFILTERS ( dim_pays ), fact_marche[code_pays] = r, fact_marche[annee] = 2025, fact_marche[segment] = "Casual moulé & sandales" ) VAR a = CALCULATE ( SUM ( fact_marche[taille_marche_meur] ), REMOVEFILTERS ( dim_pays ), fact_marche[code_pays] = p, fact_marche[annee] = 2024, fact_marche[segment] = "Casual moulé & sandales" ) VAR d = v - a RETURN IF ( d > 0, "#2E7D32", IF ( d < 0, "#C62828", "#80868B" ) )
		lineageTag: 528576db-5eab-4e45-abb8-7254c21b38fd

	measure 'PdM Crocs 2025' = /* #v8 */ VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR v = CALCULATE ( AVERAGE ( fact_parts_de_marche[part_marche_valeur_pct] ), REMOVEFILTERS ( dim_pays ), REMOVEFILTERS ( dim_concurrent ), fact_parts_de_marche[code_pays] = p, fact_parts_de_marche[annee] = 2025, dim_concurrent[nom_concurrent] = "Crocs" ) VAR w = CALCULATE ( AVERAGE ( fact_parts_de_marche[part_marche_valeur_pct] ), REMOVEFILTERS ( dim_pays ), REMOVEFILTERS ( dim_concurrent ), fact_parts_de_marche[code_pays] = r, fact_parts_de_marche[annee] = 2025, dim_concurrent[nom_concurrent] = "Crocs" ) VAR a = CALCULATE ( AVERAGE ( fact_parts_de_marche[part_marche_valeur_pct] ), REMOVEFILTERS ( dim_pays ), REMOVEFILTERS ( dim_concurrent ), fact_parts_de_marche[code_pays] = p, fact_parts_de_marche[annee] = 2024, dim_concurrent[nom_concurrent] = "Crocs" ) RETURN IF ( ISBLANK ( v ), "n.d.", SUBSTITUTE ( SUBSTITUTE ( FORMAT ( v, "0.00" ), ",", " " ), ".", "," ) & " %" )
		lineageTag: bc8bb38b-16b7-4aac-9129-c4b4623c7462

	measure 'PdM Crocs 2025 vs pays' = /* #v8 */ VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR v = CALCULATE ( AVERAGE ( fact_parts_de_marche[part_marche_valeur_pct] ), REMOVEFILTERS ( dim_pays ), REMOVEFILTERS ( dim_concurrent ), fact_parts_de_marche[code_pays] = p, fact_parts_de_marche[annee] = 2025, dim_concurrent[nom_concurrent] = "Crocs" ) VAR w = CALCULATE ( AVERAGE ( fact_parts_de_marche[part_marche_valeur_pct] ), REMOVEFILTERS ( dim_pays ), REMOVEFILTERS ( dim_concurrent ), fact_parts_de_marche[code_pays] = r, fact_parts_de_marche[annee] = 2025, dim_concurrent[nom_concurrent] = "Crocs" ) VAR a = CALCULATE ( AVERAGE ( fact_parts_de_marche[part_marche_valeur_pct] ), REMOVEFILTERS ( dim_pays ), REMOVEFILTERS ( dim_concurrent ), fact_parts_de_marche[code_pays] = p, fact_parts_de_marche[annee] = 2024, dim_concurrent[nom_concurrent] = "Crocs" ) VAR d = v - w RETURN IF ( ISBLANK ( v ) || ISBLANK ( w ), "–", IF ( d > 0, "▲ +", IF ( d < 0, "▼ −", "= " ) ) & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ABS ( d ), "0.00" ), ",", " " ), ".", "," ) & " pt" & " vs " & nr )
