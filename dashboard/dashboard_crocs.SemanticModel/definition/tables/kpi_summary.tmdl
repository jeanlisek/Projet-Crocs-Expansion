table kpi_summary
	lineageTag: 046a9d3f-d0c5-4ecd-b716-d8f4fd528bb2

	measure 'Nb critères GO DE' = CALCULATE ( COUNTROWS ( kpi_summary ), kpi_summary[pays] = "DE", kpi_summary[statut_go] = "GO" )
		formatString: 0
		lineageTag: ad3c9904-a10f-4255-a753-393c956e4f5d

	measure 'Nb critères évalués DE' = CALCULATE ( COUNTROWS ( kpi_summary ), kpi_summary[pays] = "DE", kpi_summary[statut_go] IN { "GO", "NO-GO" } )
		formatString: 0
		lineageTag: c5f721bd-3176-4353-bb40-4a76c4fe3da7

	measure 'Verdict DE' =
			VAR go = [Nb critères GO DE]
			VAR n = [Nb critères évalués DE]
			RETURN IF ( n = 0, "En attente", IF ( go = n, "GO", "NO-GO" ) ) & " : " & go & " critère(s) au vert sur " & n & " calculé(s) / 6"
		lineageTag: 5c1de229-0c57-4d4b-af1c-9d9067110bda

	measure 'Nb critères NO-GO DE' = CALCULATE ( COUNTROWS ( kpi_summary ), kpi_summary[pays] = "DE", kpi_summary[statut_go] = "NO-GO" )
		formatString: 0
		lineageTag: 50109999-71e9-4634-8428-b3561421eb04

	measure 'Verdict court DE' = IF ( [Nb critères évalués DE] = 0, "En attente", IF ( [Nb critères NO-GO DE] = 0, "GO", "NO-GO" ) )
		lineageTag: 3f3fd848-b9b5-4f99-bd3d-d68a90dcf20b

	measure 'Score GO DE' = [Nb critères GO DE] & " / " & [Nb critères évalués DE]
		lineageTag: 00d84d02-7c87-44ea-b5cd-73a0965e0640

	measure 'Valeur pays choisi' = VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) RETURN CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p )
		lineageTag: be32c1e6-9833-4ae0-818d-b75e21524edd

	measure 'Couleur pays' = IF ( SELECTEDVALUE ( kpi_summary[pays] ) = "DE", "#84BD00", "#C9CFC0" )
		lineageTag: b6f33891-e484-4827-9756-d02e5be1562a

	measure 'Couleur concurrent' = IF ( SELECTEDVALUE ( dim_concurrent[nom_concurrent] ) = "Crocs", "#84BD00", "#C9CFC0" )
		lineageTag: fdd54e32-3f7f-4ad4-8ad1-2d00cf3bfdaa

	measure 'Couleur statut' = SWITCH ( SELECTEDVALUE ( kpi_summary[statut_go] ), "GO", "#DDEFB8", "NO-GO", "#F6E3C2", BLANK () )
		lineageTag: 065acd34-2b43-4a9f-84b2-864427efb8c7

	measure 'Condition GO' = VAR r = CALCULATE ( MIN ( sensibilite_payback[ca_m2_ratio_min_go] ), sensibilite_payback[nb_etp] = 3 ) RETURN "≈ 3 ETP et CA/m² ≥ France " & IF ( r >= 1, "+", "" ) & FORMAT ( ( r - 1 ) * 100, "0" ) & " % (centre commercial)"
		lineageTag: 18d94a2f-5599-44ca-8dda-5be963be733f

	measure 'Taille réelle' = CALCULATE ( SUM ( fact_marche[taille_marche_meur] ), fact_marche[est_projection] = FALSE () )
		lineageTag: d784e7e3-24c8-401d-8b5b-e72111537f0a

	measure 'Taille projetée' = IF ( MAX ( fact_marche[annee] ) >= 2025, SUM ( fact_marche[taille_marche_meur] ) )
		lineageTag: 33939520-eae7-4a55-9b03-7a587c8b9c99

	measure 'Eurostat pays choisi' = VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) RETURN CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p, CONTAINSSTRING ( kpi_summary[kpi], "Eurostat" ) )
		formatString: 0.0
		lineageTag: c6454a50-f8c2-4c66-ba7c-9a99b44462e0

	measure 'Indice prix vs Crocs' = VAR c = CALCULATE ( AVERAGE ( fact_prix_releves[prix_affiche_eur] ), fact_prix_releves[en_promotion] = FALSE (), REMOVEFILTERS ( dim_concurrent ), dim_concurrent[nom_concurrent] = "Crocs" ) VAR x = CALCULATE ( AVERAGE ( fact_prix_releves[prix_affiche_eur] ), fact_prix_releves[en_promotion] = FALSE () ) RETURN DIVIDE ( x, c ) * 100
		formatString: 0
		lineageTag: f882e5bc-b656-406e-b92c-6568dc663a58

	measure 'Valeur affichée' = /* #v8 */ VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR k = SELECTEDVALUE ( kpi_summary[kpi] ) VAR suf = MID ( k, SEARCH ( " : ", k, 1, LEN ( k ) ) + 3, 200 ) VAR kr = SWITCH ( TRUE (), CONTAINSSTRING ( k, "Coût d'occupation (loyer + charges ÷ CA, scénario" ), "Coût d'occupation (loyer + charges ÷ CA, même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Payback (scénario" ), "Payback (même périmètre de coûts que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Point mort par magasin : " ), "Point mort par magasin (même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Impôt sur les sociétés (taux combiné" ), "Impôt sur les sociétés (taux normal, hors surtaxes)", CONTAINSSTRING ( k, "Impôt sur les sociétés (taux normal" ), "Impôt sur les sociétés (taux combiné : IS, solidarité et taxe professionnelle moyenne incluses)", k ) VAR v = CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR nv = CALCULATE ( COUNTROWS ( kpi_summary ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR w = IF ( r = "FR" && CONTAINSSTRING ( k, "Indice prix relatif (HT" ), 100, CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = r, kpi_summary[kpi] = kr ) ) VAR u = CALCULATE ( MAX ( kpi_summary[unite] ), REMOVEFILTERS ( dim_pays ) ) VAR fm = SWITCH ( TRUE (), u = "mois", "0.0", u = "km" || CONTAINSSTRING ( u, "€" ), "#,0", "0.00" ) VAR us = SWITCH ( u, "%", " %", "indice", "", " " & u ) VAR ug = SWITCH ( u, "%", " pt", "indice", " pt", " " & u ) VAR inv = CONTAINSSTRING ( k, "Coût" ) || CONTAINSSTRING ( k, "Payback" ) || CONTAINSSTRING ( k, "Point mort" ) || CONTAINSSTRING ( k, "Impôt" ) || CONTAINSSTRING ( k, "TVA" ) || CONTAINSSTRING ( k, "Droit" ) || CONTAINSSTRING ( k, "Densité" ) || CONTAINSSTRING ( k, "Distance" ) || CONTAINSSTRING ( k, "Éco-contribution" ) VAR pb = CONTAINSSTRING ( k, "Payback" ) VAR s = CALCULATE ( MAX ( kpi_summary[seuil] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = "DE" ) VAR n = CALCULATE ( MAX ( kpi_summary[seuil_num] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = "DE" ) VAR nf = IF ( n = INT ( n ), FORMAT ( n, "0" ), SUBSTITUTE ( FORMAT ( n, "0.00" ), ".", "," ) ) RETURN IF ( nv = 0, "n.d.", IF ( ISBLANK ( v ), IF ( pb, "> 120 mois", "n.d." ), SUBSTITUTE ( SUBSTITUTE ( FORMAT ( v, fm ), ",", " " ), ".", "," ) & us ) )
		lineageTag: 29e0aa2d-129e-48e4-a57e-3fa76e712da5

	measure 'Écart vs comparé' = /* #v8 */ VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR k = SELECTEDVALUE ( kpi_summary[kpi] ) VAR suf = MID ( k, SEARCH ( " : ", k, 1, LEN ( k ) ) + 3, 200 ) VAR kr = SWITCH ( TRUE (), CONTAINSSTRING ( k, "Coût d'occupation (loyer + charges ÷ CA, scénario" ), "Coût d'occupation (loyer + charges ÷ CA, même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Payback (scénario" ), "Payback (même périmètre de coûts que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Point mort par magasin : " ), "Point mort par magasin (même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Impôt sur les sociétés (taux combiné" ), "Impôt sur les sociétés (taux normal, hors surtaxes)", CONTAINSSTRING ( k, "Impôt sur les sociétés (taux normal" ), "Impôt sur les sociétés (taux combiné : IS, solidarité et taxe professionnelle moyenne incluses)", k ) VAR v = CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR nv = CALCULATE ( COUNTROWS ( kpi_summary ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR w = IF ( r = "FR" && CONTAINSSTRING ( k, "Indice prix relatif (HT" ), 100, CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = r, kpi_summary[kpi] = kr ) ) VAR u = CALCULATE ( MAX ( kpi_summary[unite] ), REMOVEFILTERS ( dim_pays ) ) VAR fm = SWITCH ( TRUE (), u = "mois", "0.0", u = "km" || CONTAINSSTRING ( u, "€" ), "#,0", "0.00" ) VAR us = SWITCH ( u, "%", " %", "indice", "", " " & u ) VAR ug = SWITCH ( u, "%", " pt", "indice", " pt", " " & u ) VAR inv = CONTAINSSTRING ( k, "Coût" ) || CONTAINSSTRING ( k, "Payback" ) || CONTAINSSTRING ( k, "Point mort" ) || CONTAINSSTRING ( k, "Impôt" ) || CONTAINSSTRING ( k, "TVA" ) || CONTAINSSTRING ( k, "Droit" ) || CONTAINSSTRING ( k, "Densité" ) || CONTAINSSTRING ( k, "Distance" ) || CONTAINSSTRING ( k, "Éco-contribution" ) VAR pb = CONTAINSSTRING ( k, "Payback" ) VAR s = CALCULATE ( MAX ( kpi_summary[seuil] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = "DE" ) VAR n = CALCULATE ( MAX ( kpi_summary[seuil_num] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = "DE" ) VAR nf = IF ( n = INT ( n ), FORMAT ( n, "0" ), SUBSTITUTE ( FORMAT ( n, "0.00" ), ".", "," ) ) RETURN IF ( nv = 0 || ISBLANK ( w ), "pas de valeur " & nr & "", IF ( ISBLANK ( v ), IF ( pb, "Non atteint en 10 ans · " & nr & " : " & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( w, fm ), ",", " " ), ".", "," ) & us, BLANK () ), IF ( v - w > 0, "▲ +", IF ( v - w < 0, "▼ −", "= " ) ) & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( ABS ( v - w ), fm ), ",", " " ), ".", "," ) & ug & " vs " & nr ) )
		lineageTag: d1a09e34-f67e-493f-9ef3-bb104d46fa69

	measure 'Couleur écart vs comparé' = /* #v8 */ VAR p = SELECTEDVALUE ( dim_pays[code_pays], "DE" ) VAR r = IF ( p = "FR", "DE", "FR" ) VAR nr = IF ( r = "FR", "France", "Allemagne" ) VAR k = SELECTEDVALUE ( kpi_summary[kpi] ) VAR suf = MID ( k, SEARCH ( " : ", k, 1, LEN ( k ) ) + 3, 200 ) VAR kr = SWITCH ( TRUE (), CONTAINSSTRING ( k, "Coût d'occupation (loyer + charges ÷ CA, scénario" ), "Coût d'occupation (loyer + charges ÷ CA, même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Payback (scénario" ), "Payback (même périmètre de coûts que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Point mort par magasin : " ), "Point mort par magasin (même périmètre que l'Allemagne) : " & suf, CONTAINSSTRING ( k, "Impôt sur les sociétés (taux combiné" ), "Impôt sur les sociétés (taux normal, hors surtaxes)", CONTAINSSTRING ( k, "Impôt sur les sociétés (taux normal" ), "Impôt sur les sociétés (taux combiné : IS, solidarité et taxe professionnelle moyenne incluses)", k ) VAR v = CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR nv = CALCULATE ( COUNTROWS ( kpi_summary ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = p ) VAR w = IF ( r = "FR" && CONTAINSSTRING ( k, "Indice prix relatif (HT" ), 100, CALCULATE ( AVERAGE ( kpi_summary[valeur] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = r, kpi_summary[kpi] = kr ) ) VAR u = CALCULATE ( MAX ( kpi_summary[unite] ), REMOVEFILTERS ( dim_pays ) ) VAR fm = SWITCH ( TRUE (), u = "mois", "0.0", u = "km" || CONTAINSSTRING ( u, "€" ), "#,0", "0.00" ) VAR us = SWITCH ( u, "%", " %", "indice", "", " " & u ) VAR ug = SWITCH ( u, "%", " pt", "indice", " pt", " " & u ) VAR inv = CONTAINSSTRING ( k, "Coût" ) || CONTAINSSTRING ( k, "Payback" ) || CONTAINSSTRING ( k, "Point mort" ) || CONTAINSSTRING ( k, "Impôt" ) || CONTAINSSTRING ( k, "TVA" ) || CONTAINSSTRING ( k, "Droit" ) || CONTAINSSTRING ( k, "Densité" ) || CONTAINSSTRING ( k, "Distance" ) || CONTAINSSTRING ( k, "Éco-contribution" ) VAR pb = CONTAINSSTRING ( k, "Payback" ) VAR s = CALCULATE ( MAX ( kpi_summary[seuil] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = "DE" ) VAR n = CALCULATE ( MAX ( kpi_summary[seuil_num] ), REMOVEFILTERS ( dim_pays ), kpi_summary[pays] = "DE" ) VAR nf = IF ( n = INT ( n ), FORMAT ( n, "0" ), SUBSTITUTE ( FORMAT ( n, "0.00" ), ".", "," ) ) VAR d = IF ( ISBLANK ( v ) && pb, 999, v - w ) VAR sg = IF ( inv, -d, d ) RETURN IF ( nv = 0 || ISBLANK ( w ), "#80868B", IF ( sg > 0, "#2E7D32", IF ( sg < 0, "#C62828", "#80868B" ) ) )
