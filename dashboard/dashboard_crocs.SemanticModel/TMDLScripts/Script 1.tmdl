						Types = Table.TransformColumnTypes(Entetes, {{"id_releve", Int64.Type}, {"id_date", Int64.Type}, {"code_pays", type text}, {"enseigne", type text}, {"id_concurrent", type text}, {"id_produit", type text}, {"libelle_produit", type text}, {"categorie", type text}, {"prix_affiche_eur", type number}, {"prix_affiche_devise_locale", type number}, {"en_promotion", type logical}, {"taux_remise_pct", type number}, {"source", type text}, {"est_simule", type logical}}, "en-US")
					in
						Types

	table kpi_summary

		measure 'Nb critères GO DE' = ```
				CALCULATE ( COUNTROWS ( kpi_summary ), kpi_summary[pays] = "DE", kpi_summary[statut_go] = "GO" )
				```
			formatString: 0

		measure 'Nb critères évalués DE' = ```
				CALCULATE ( COUNTROWS ( kpi_summary ), kpi_summary[pays] = "DE", kpi_summary[statut_go] IN { "GO", "NO-GO" } )
				```
			formatString: 0

		measure 'Verdict DE' = ```
				VAR go = [Nb critères GO DE]
				VAR n = [Nb critères évalués DE]
				RETURN IF ( n = 0, "En attente", IF ( go = n, "GO", "NO-GO" ) ) & " : " & go & " critère(s) au vert sur " & n & " calculé(s) / 6"
				```

		column kpi
			dataType: string
			sourceColumn: kpi

		column axe
			dataType: string
			sourceColumn: axe

		column pays
			dataType: string
			sourceColumn: pays

		column valeur
			dataType: double
			sourceColumn: valeur
			summarizeBy: sum

		column unite
			dataType: string
			sourceColumn: unite

		column seuil
			dataType: string
			sourceColumn: seuil

		column statut_go
			dataType: string
			sourceColumn: statut_go

		column statut_epistemique
			dataType: string
			sourceColumn: statut_epistemique

		column origine_donnees
			dataType: string
			sourceColumn: origine_donnees

		partition kpi_summary = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DossierExports & "kpi_summary.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
						Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
						Types = Table.TransformColumnTypes(Entetes, {{"kpi", type text}, {"axe", type text}, {"pays", type text}, {"valeur", type number}, {"unite", type text}, {"seuil", type text}, {"statut_go", type text}, {"statut_epistemique", type text}, {"origine_donnees", type text}}, "en-US")
					in
						Types

	table ai_commentary

		measure 'Commentaire Synthèse' = ```
				LOOKUPVALUE ( ai_commentary[texte], ai_commentary[page], "synthese", ai_commentary[valeur_filtre], "TOUS" )
				```

		measure 'Commentaire Marché' = ```
				LOOKUPVALUE ( ai_commentary[texte], ai_commentary[page], "marche_prix",
				    ai_commentary[valeur_filtre], SELECTEDVALUE ( dim_pays[code_pays], "TOUS" ) )
				```

		measure 'Commentaire Implantation' = ```
				LOOKUPVALUE ( ai_commentary[texte], ai_commentary[page], "implantation",
				    ai_commentary[valeur_filtre], SELECTEDVALUE ( dim_zone_chalandise[id_zone], "TOUS" ) )
				```

		column page
			dataType: string
			sourceColumn: page

		column filtre
			dataType: string
			sourceColumn: filtre

		column valeur_filtre
			dataType: string
			sourceColumn: valeur_filtre

		column texte
			dataType: string
			sourceColumn: texte

		column verifie
			dataType: boolean
			sourceColumn: verifie

		column date_generation
			dataType: string
			sourceColumn: date_generation

		partition ai_commentary = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DossierMaquette & "ai_commentary_FACTICE.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
						Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
						Types = Table.TransformColumnTypes(Entetes, {{"page", type text}, {"filtre", type text}, {"valeur_filtre", type text}, {"texte", type text}, {"verifie", type logical}, {"date_generation", type text}}, "en-US")
					in
						Types

	relationship rel_kpi_summary_pays
		fromColumn: kpi_summary.pays
		toColumn: dim_pays.code_pays

	relationship rel_dim_zone_chalandise_code_pays
		fromColumn: dim_zone_chalandise.code_pays
		toColumn: dim_pays.code_pays

	relationship rel_fact_marche_code_pays
		fromColumn: fact_marche.code_pays
		toColumn: dim_pays.code_pays

	relationship rel_fact_parts_de_marche_code_pays
		fromColumn: fact_parts_de_marche.code_pays
		toColumn: dim_pays.code_pays

	relationship rel_fact_prix_releves_code_pays
		fromColumn: fact_prix_releves.code_pays
		toColumn: dim_pays.code_pays

	relationship rel_fact_immobilier_id_zone
		fromColumn: fact_immobilier.id_zone
		toColumn: dim_zone_chalandise.id_zone

	relationship rel_densite_concurrentielle_id_zone
		fromColumn: densite_concurrentielle.id_zone
		toColumn: dim_zone_chalandise.id_zone

	relationship rel_distance_hub_id_zone
		fromColumn: distance_hub.id_zone
		toColumn: dim_zone_chalandise.id_zone

	relationship rel_fact_parts_de_marche_id_concurrent
		fromColumn: fact_parts_de_marche.id_concurrent
		toColumn: dim_concurrent.id_concurrent

	relationship rel_fact_prix_releves_id_concurrent
		fromColumn: fact_prix_releves.id_concurrent
		toColumn: dim_concurrent.id_concurrent

	relationship rel_fact_prix_releves_id_produit
		fromColumn: fact_prix_releves.id_produit
		toColumn: dim_produit.id_produit

	relationship rel_fact_prix_releves_id_date
		fromColumn: fact_prix_releves.id_date
		toColumn: dim_temps.id_date
